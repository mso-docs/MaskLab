# Documentation only: the application intentionally does not automatically load .env files.
# Keep actual credentials external to Git and configure the server process environment.
MASKLAB_MODE=owner
MASKLAB_DATA_DIR=./artifacts/workspace
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
NEBIUS_API_KEY=
MASKLAB_CAPABILITIES_FILE=
MASKLAB_APPROVED_SPEND_USD=0
MASKLAB_OWNER_TOKEN=
MASKLAB_MAX_REQUESTS=5000
MASKLAB_MAX_CONCURRENCY=4
# A key never authorizes spending. Paid-call approval remains separately required.

# Explicit operator-reviewed shared ledger; missing/uninitialized ledger blocks inference.
MASKLAB_SPEND_LEDGER=
MASKLAB_AUTHORIZATION_ID=
# Use: masklab serve --env-file /private/path/.env (never shell-source the file).
